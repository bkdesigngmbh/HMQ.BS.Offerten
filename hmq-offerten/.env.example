# Supabase (erforderlich) — Werte aus dem Supabase-Projekt (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# CloudConvert (optional) — aktiviert PDF-Export. Ohne Key wird nur DOCX erzeugt.
CLOUDCONVERT_API_KEY=

# Basic Auth (erforderlich) — schützt die ganze App (proxy.ts).
# Ohne diese Werte bleibt die App gesperrt (fail closed).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
